# =============================================================================
#  Catálogo WhatsApp / COD — Environment variables
#  Copy this file to ".env.local" and fill in the values.
#  NEVER commit ".env.local". Secrets must live ONLY here / in Vercel.
# =============================================================================

# ---- App ---------------------------------------------------------------------
# Public base URL of the app. Locally: http://localhost:3000
# In production: https://your-domain.com (or the Vercel URL).
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# ---- Supabase (Project Settings → API) --------------------------------------
# Project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# anon/public key (safe for the browser)
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key (SERVER ONLY — bypasses Row Level Security, never expose it)
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (Developers → API keys) -----------------------------------------
# Secret key: sk_test_... (test mode) or sk_live_...
STRIPE_SECRET_KEY=
# Base plan price ID (flat recurring, e.g. $4.90/month): price_...
STRIPE_PRICE_ID=
# Usage price ID (metered, e.g. $0.10 per order generated): price_...
# Leave empty to disable per-order usage billing.
STRIPE_USAGE_PRICE_ID=
# Meter event name (must match the Stripe Billing Meter you create).
STRIPE_USAGE_METER_EVENT=order_generated
# Webhook signing secret: whsec_... (from the webhook endpoint you create)
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends the user back after the Customer Portal
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/dashboard/billing
# Free trial length in days
STRIPE_TRIAL_DAYS=14

# ---- Shopify (Partners → your app → API credentials) — used in Phase 2 ------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Comma-separated scopes
SHOPIFY_SCOPES=read_products,read_inventory,write_orders,read_customers,write_customers
# Public URL of THIS app (must match the app URL configured in Partners)
SHOPIFY_APP_URL=http://localhost:3000

# ---- Encryption --------------------------------------------------------------
# 32-byte key, base64-encoded, used to AES-256-GCM encrypt access tokens.
# Generate one with:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
